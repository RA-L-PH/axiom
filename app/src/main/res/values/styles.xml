<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Axiom" parent="Base.Theme.Axiom"/>

    <style name="Theme.Axiom.Light" parent="Base.Theme.Axiom.Light"/>

    <style name="Theme.Axiom.Black" parent="Base.Theme.Axiom.Black"/>

    <style name="Theme.Axiom.FollowSystem" parent="Base.Theme.Axiom.Adaptive"/>

    <style name="Theme.Axiom.SplashScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Axiom.Expressive.Button" parent="Widget.Material3Expressive.Button">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Axiom.Expressive.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Axiom.Expressive.Button.Icon.Filled" parent="Widget.Material3Expressive.Button">
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="iconTint">@color/md_theme_onPrimary</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:insetLeft">2dp</item>
        <item name="android:insetRight">2dp</item>
    </style>

    <style name="Widget.Axiom.Expressive.Button.Icon.Filled.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="iconTint">@color/md_theme_onSecondaryContainer</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:insetLeft">2dp</item>
        <item name="android:insetRight">2dp</item>
    </style>

    <style name="Widget.Axiom.BottomNavigation" parent="Widget.Material3Expressive.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Axiom.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.Axiom.BottomNav.ActiveIndicator" parent="Widget.Material3Expressive.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="HomeActionButton" parent="Widget.Material3Expressive.Button">
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">#FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="fontFamily">@font/ndot57</item>
        <item name="android:fontFamily">@font/ndot57</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="icon">@null</item>
    </style>

    <style name="HomeActionButton.Shuffle" parent="Widget.Material3Expressive.Button">
        <item name="android:gravity">center</item>
        <item name="android:textColor">#D71921</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">#D71921</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="fontFamily">@font/ndot57</item>
        <item name="android:fontFamily">@font/ndot57</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="icon">@null</item>
    </style>

    <style name="PlayerIconButton" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?colorOnSurface</item>
        <item name="rippleColor">?colorControlHighlight</item>
    </style>

    <style name="PlayerIconButton.Medium">
        <item name="iconSize">32dp</item>
    </style>

    <style name="PlayerIconButton.Large">
        <item name="iconSize">64dp</item>
    </style>

    <style name="SearchChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:checked">false</item>
        <item name="android:textSize">16sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">10dp</item>
    </style>

    <style name="MenuButtonStyle" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">false</item>
        <item name="icon">@drawable/ic_more_vert_24dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="android:maxWidth">@null</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
    </style>

    <style name="ModalBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?colorSurfaceContainer</item>
        <item name="shapeAppearance">?shapeAppearanceCornerLarge</item>
    </style>

    <style name="ModalBottomSheetStyle.EdgeToEdge">
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="CircularShapeAppearance" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="SquareShapeAppearance" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Base.SquigglySlider" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">?colorPrimary</item>
        <item name="android:thumbTint">?colorPrimary</item>
        <item name="android:progressBackgroundTint">?android:attr/textColorTertiary</item>
        <item name="android:clickable">true</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumb">@drawable/squiggly_thumb</item>
    </style>

    <style name="SquigglySlider" parent="Base.SquigglySlider">
        <item name="android:progressDrawable">@drawable/media_squiggly_progress</item>
    </style>

    <style name="SideSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

</resources>
