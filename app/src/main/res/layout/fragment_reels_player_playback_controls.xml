<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top Mask Gradient -->
    <View
        android:id="@+id/top_mask"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/shadow_down_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Mask Gradient for Metadata -->
    <View
        android:id="@+id/bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/shadow_up_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/close"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/close_action"
            app:backgroundTint="#00000000"
            app:icon="@drawable/ic_back_24dp"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/topRightQueueButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="8dp"
            android:layout_marginEnd="16dp"
            app:backgroundTint="#00000000"
            app:icon="@drawable/ic_reels_queue"
            app:iconSize="28dp"
            app:iconTint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timeProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="01:23 / 03:45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden Persistent Play/Pause (Required by base class AbsPlayerControlsFragment) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/playPauseButton"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        android:contentDescription="@string/action_play_pause"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Transient Play/Pause Indicator in the Center -->
    <ImageView
        android:id="@+id/centerPlayPauseIndicator"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.0"
        android:visibility="invisible"
        android:contentDescription="@string/action_play_pause"
        app:srcCompat="@drawable/ic_play_24dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transient Heart Indicator in the Center for Double Tap -->
    <ImageView
        android:id="@+id/doubleTapHeartIndicator"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:alpha="0.0"
        android:visibility="invisible"
        android:contentDescription="@string/action_add_to_favorites"
        app:srcCompat="@drawable/ic_favorite_filled_red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right Column Controls -->
    <LinearLayout
        android:id="@+id/rightControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/progressSlider"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favorite"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_favorite_outline_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToPlaylistButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_playlist_add_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyricsButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_lyrics_outline_white"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shuffleButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_shuffle_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/repeatButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_repeat_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_share_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speakerButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_volume_up_24dp"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/queueButton"
            style="@style/PlayerIconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_reels_menu"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom Left Metadata Zone -->
    <LinearLayout
        android:id="@+id/metaContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/progressSlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightControls">

        <!-- Title in NDot57 -->
        <com.rc.axiom.ui.screen.player.styles.reelsstyle.ProgressTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ndot57"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:shadowColor="#80000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="2"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Autumn Variations" />

        <!-- Subtitle in Monospace (artistName & albumName) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:shadowColor="#80000000"
            android:shadowDx="1.0"
            android:shadowDy="1.0"
            android:shadowRadius="1.5"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            tools:text="Ed Sheeran" />

        <!-- More Info text button -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/moreInfoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#D71921"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:text="[more info]"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp" />

        <!-- Expandable Trigger text (more...info...) in Monospace -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/songInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            tools:text="more...info..." />

    </LinearLayout>

    <!-- Hidden Time Indicators (required by AbsPlayerControlsFragment, but kept tiny/subtle) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/songCurrentProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/songTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <!-- Thin Progress Bar/Slider at the bottom edge -->
    <com.rc.axiom.ui.component.views.MusicSlider
        android:id="@+id/progressSlider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:padding="0dp"
        android:layout_marginBottom="0dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
